 // Release the split's lock while preserving an I/O error.
@@ -237,6 +241,28 @@ static int dynfilefs_read(const char *path, char *buf, size_t size, off_t offset
 }
 
 
+// Reserve growth in chunks, preserving file length and ordinary writes on unsupported or full filesystems.
+static int reserve_storage(int ix, off_t end)
+{
+    if (preallocation_ends[ix]<0 || end<=preallocation_ends[ix]) return 0;
+    off_t capacity=virtual_size-ix*split_size;
+    if (capacity > split_size) capacity=split_size;
+    off_t limit=header_size+offset_block_size+capacity;
+    off_t target=(end+PREALLOCATE_SIZE-1)/PREALLOCATE_SIZE*PREALLOCATE_SIZE;
+    if (target > limit) target=limit;
+    if (!fallocate(fileno(files[ix]), FALLOC_FL_KEEP_SIZE, preallocation_ends[ix], target-preallocation_ends[ix]))
+    {
+        preallocation_ends[ix]=target;
+        return 0;
+    }
+    int error=errno;
+    int unsupported=error==EOPNOTSUPP || error==ENOSYS || error==EINVAL;
+    int capacity_error=error==ENOSPC || error==EDQUOT || error==EFBIG;
+    if (unsupported) preallocation_ends[ix]=-1;
+    if (unsupported || capacity_error) return 0;
+    return -error;
+}
